  "bom": [
    {
      "id": "shaft_cap",
      "name": "Rigid shaft clamp cap",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "Integral paired actuator rail and four-fastener collar closure; no shaft-retaining bands. Fit and loaded retention unvalidated."
    },
    {
      "id": "carrier",
      "name": "Fixed jaw, sliding track and shaft saddle",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "Hard rear datum and centered band posts; the removable cap carries the actuator rail."
    },
    {
      "id": "sliding_jaw",
      "name": "Sliding opposing jaw",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "Compact opposing jaw without an actuator rail. Turn the phone end-for-end for originally far-side buttons; 66\u201386 mm width is a geometric range, not qualified."
    },
    {
      "id": "actuator_bracket",
      "name": "Reversible actuator bracket",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "Either shaft-side rail position; slide along the phone and adjust depth in the two vertical slots before tightening printed nuts."
    },
    {
      "id": "rocker",
      "name": "Threaded-contact rocker",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "Tie the twine directly around the 8 mm eye with a closed loop. Contact screw adjusts button gap; printed stops limit the illustrative stroke."
    },
    {
      "id": "pivot_key",
      "name": "Quarter-turn pivot key",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "Printed 6 mm pivot; insert cross-lug through keyway, turn and seat head at index lug."
    },
    {
      "id": "thumb_screw",
      "name": "Coarse printed thumb screw",
      "quantity": 7,
      "material": "PLA / PLA+",
      "note": "Four shaft clamps, two rail clamps plus one button contact. 8 mm major / 3 mm pitch; matches successful original-size trial. Existing trial screws can be reused."
    },
    {
      "id": "thumb_nut",
      "name": "Printed clamp nut",
      "quantity": 6,
      "material": "PLA / PLA+",
      "note": "Matches successful 8\u00d73 trial nut, including entry lead-ins. Hand-tighten only; loaded retention remains untested."
    },
    {
      "id": "string_guide",
      "name": "Captive shaft guide",
      "quantity": 3,
      "material": "PLA / PLA+",
      "note": "Band-held open saddle with reinforced D-shaped lug; 8 mm bore, 11 mm flared mouths. Smooth the twine-contact surfaces."
    },
    {
      "id": "twine",
      "name": "One continuous twine length",
      "quantity": 1,
      "material": "Twine",
      "note": "Route behind the phone through closed eyes; leave enough for knots. Display diameter 2 mm is provisional; passage check uses 3 mm, actual twine unknown."
    },
    {
      "id": "rubber_bands",
      "name": "Rubber bands",
      "quantity": 7,
      "material": "Rubber",
      "note": "2 jaw closing + 3 guides + 1 return + 1 trigger overtravel. Actual preload and loop count need fitting."
    }
