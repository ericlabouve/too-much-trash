  "bom": [
    {
      "id": "shaft_cap",
      "name": "Rigid shaft clamp cap",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "Integral paired actuator rail and four-fastener collar closure; no shaft-retaining bands. Fit and loaded retention unvalidated."
    },
    {
      "id": "carrier",
      "name": "Fixed jaw, sliding track and shaft saddle",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "Hard rear datum and one broad angular band cleat; the removable cap carries the actuator rail."
    },
    {
      "id": "sliding_jaw",
      "name": "Sliding opposing jaw",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "T-shaped jaw has two pads 100 mm apart, a midpoint-closing tongue, 4 mm retaining lips and one broad angular band cleat. Turn the phone end-for-end for originally far-side buttons; 66\u201386 mm width is a geometric range, not qualified."
    },
    {
      "id": "actuator_bracket",
      "name": "Reversible actuator bracket",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "Either shaft-side rail position; select the position along the cap rail, then secure through two fixed 8.8 mm center holes; no bracket-depth adjustment."
    },
    {
      "id": "rocker",
      "name": "Broad-shoe rocker",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "Tie the twine directly around the 8 mm eye with a closed loop. Integral perpendicular 4 mm-wide by 16 mm-tall shoe replaces the loosening contact screw; stops allow threefold free rotation. Safe button force/travel are unvalidated."
    },
    {
      "id": "pivot_key",
      "name": "Quarter-turn pivot key",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "Printed 6 mm pivot; insert cross-lug through keyway, turn and seat head at index lug."
    },
    {
      "id": "thumb_screw",
      "name": "Coarse printed thumb screw",
      "quantity": 6,
      "material": "PLA / PLA+",
      "note": "Four shaft clamps and two rail clamps; integral rocker shoe replaces the button screw. 8 mm major / 3 mm pitch; matches successful original-size trial. Existing trial screws can be reused."
    },
    {
      "id": "thumb_nut",
      "name": "Printed clamp nut",
      "quantity": 6,
      "material": "PLA / PLA+",
      "note": "Matches successful 8\u00d73 trial nut, including entry lead-ins. Hand-tighten only; loaded retention remains untested."
    },
    {
      "id": "dual_string_guide",
      "name": "Duel captive guide",
      "quantity": 1,
      "material": "PLA / PLA+",
      "note": "Install nearest the harness; select the eye facing the actuator. Two 8 mm bores with flared entrances."
    },
    {
      "id": "string_guide",
      "name": "Captive shaft guide",
      "quantity": 2,
      "material": "PLA / PLA+",
      "note": "Band-held open saddle with reinforced D-shaped lug; 8 mm bore, 11 mm flared mouths. Smooth the twine-contact surfaces."
    },
    {
      "id": "twine",
      "name": "One continuous twine length",
      "quantity": 1,
      "material": "Twine",
      "note": "Route through the captive actuator eyes directly to broad-face shaft guides; leave enough for knots. Display diameter 2 mm is provisional; passage check uses 3 mm, actual twine unknown."
    },
    {
      "id": "rubber_bands",
      "name": "Rubber bands",
      "quantity": 7,
      "material": "Rubber",
      "note": "2 jaw closing + 3 guides + 1 return + 1 trigger overtravel. Actual preload and loop count need fitting."
    }
  ],
