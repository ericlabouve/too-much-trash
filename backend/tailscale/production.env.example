# Use only on the separate production host, alongside its own backend/.env.
# This selects PUBLIC website/API routing. Admin 8443 remains private.
# Never use this for a developer's stack or copy development node-state volumes.
TAILSCALE_HOSTNAME=too-much-trash
TAILSCALE_TAG=tag:tmt-prod
TAILSCALE_IMAGE=tailscale/tailscale:v1.102.4
TAILSCALE_SERVE_CONFIG=serve.production.json
