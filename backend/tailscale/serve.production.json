{
  "TCP": {
    "443": {"HTTPS": true},
    "8443": {"HTTPS": true},
    "10000": {"HTTPS": true}
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {"Handlers": {"/": {"Proxy": "http://127.0.0.1:80"}}},
    "${TS_CERT_DOMAIN}:8443": {"Handlers": {"/": {"Proxy": "http://127.0.0.1:8081"}}},
    "${TS_CERT_DOMAIN}:10000": {"Handlers": {"/": {"Proxy": "http://127.0.0.1:8082"}}}
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": true,
    "${TS_CERT_DOMAIN}:8443": false,
    "${TS_CERT_DOMAIN}:10000": true
  }
}
