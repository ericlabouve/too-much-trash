  "tests": [
    {
      "src": "elabouve@gmail.com",
      "proto": "tcp",
      "accept": ["tag:tmt-dev-eric:8443", "tag:tmt-dev-eric:10000"],
      "deny": ["tag:tmt-dev-eric:22", "tag:tmt-dev-eric:8081", "tag:tmt-dev-eric:8082"]
    },
    {
      "src": "group:tmt-admins",
      "proto": "tcp",
      "accept": ["tag:tmt-prod:8443", "tag:tmt-prod:443", "tag:tmt-prod-host:22", "tag:tmt-prod-host:3283", "tag:tmt-prod-host:5900"],
      "deny": ["tag:tmt-prod:22", "tag:tmt-prod:5432", "tag:tmt-prod-host:5432"]
