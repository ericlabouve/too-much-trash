:80 {
    encode zstd gzip
    request_body {
        max_size 201MiB
    }
    @auth path /api/v1/auth/*
    request_body @auth {
        max_size 16KiB
    }
    @private path /api/v1/admin /api/v1/admin/* /docs /docs/* /openapi.json /unlock
    handle @private {
        respond "Not found" 404
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv/public
        file_server
    }
}

:8081 {
    encode zstd gzip
    header Cache-Control "no-store"
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /unlock {
        root * /srv/admin
        rewrite * /unlock.html
        file_server
    }
    handle {
        forward_auth api:8000 {
            uri /api/v1/admin/auth/check
        }
        root * /srv/app
        try_files {path} /index.html
        file_server
    }
}
