{$SITE_ADDRESS} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy api:8000
    }

    redir /app /app/ 308

    handle_path /app/* {
        root * /srv/app
        try_files {path} /index.html
        file_server
    }

    handle {
        root * /srv/public
        file_server
    }
}
